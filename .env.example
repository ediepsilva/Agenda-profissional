# Copie para .env e ajuste. O arquivo .env NÃO deve ir para o controle de versão.

APP_ENV=local
APP_DEBUG=1
APP_TIMEZONE=America/Sao_Paulo
# URL pública usada para montar links compartilháveis (opcional; detecta automaticamente se vazio)
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agenda_profissional
DB_USER=root
DB_PASS=

# Força cookie de sessão "Secure" (use 1 em produção com HTTPS)
SESSION_SECURE=0

# Usuária dona criada pelo "php bin/seed.php".
# Se ADMIN_PASSWORD ficar vazio (ou < 8 caracteres), uma senha aleatória é gerada e exibida no terminal.
ADMIN_NAME="Dona do Studio"
ADMIN_EMAIL=dona@exemplo.com
ADMIN_PASSWORD=

# --- WhatsApp Business Platform (Cloud API oficial da Meta) ---
# Vazio = modo simulado (mensagens ficam registradas no painel, nada é enviado).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Chave secreta do app (valida a assinatura dos webhooks) e token de verificação (você inventa)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Mercado Pago (Checkout Pro: Pix e cartão) ---
# Vazio = pagamento online desativado (a cliente vê a chave Pix manual das Configurações).
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta das notificações (Suas integrações > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
